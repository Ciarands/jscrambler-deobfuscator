{
  "name": "jscrambler-deobfuscator",
  "version": "1.0.0",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "jscrambler-deobfuscator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-transformers",
    "copy-transformers": "npx cpx2 \"src/transformers/**/*\" dist/transformers",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [],
  "author": "Ciarands",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@babel/core": "^7.27.4",
    "@babel/traverse": "^7.27.4",
    "commander": "^14.0.1",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.8.1",
    "cpx2": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
